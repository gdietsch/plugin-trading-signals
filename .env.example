# Trading Signals plugin for ElizaOS. Set ONE of the options below.

# Option A: free API key (100 calls/month, no wallet needed). Get one at https://signals.incomefather.com/pricing
TRADING_SIGNALS_API_KEY=

# Option B: pay per call over x402 in USDC from a DEDICATED, low-balance wallet.
# Base (USDC on Base). Falls back to EVM_PRIVATE_KEY if unset.
TRADING_SIGNALS_EVM_PRIVATE_KEY=
# Solana (USDC on Solana), base58 or JSON byte array. Falls back to SOLANA_PRIVATE_KEY if unset.
TRADING_SIGNALS_SOLANA_PRIVATE_KEY=
# Optional Solana RPC for building the payment transaction (falls back to SOLANA_RPC_URL, then public mainnet RPC).
TRADING_SIGNALS_SOLANA_RPC_URL=

# Spend guards (USD)
TRADING_SIGNALS_MAX_USD_PER_CALL=0.05
TRADING_SIGNALS_MAX_USD_PER_DAY=1
# base or solana, when both wallets are set
TRADING_SIGNALS_PREFERRED_NETWORK=base
